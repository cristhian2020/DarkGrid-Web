---
import Layout from '../layouts/Layout.astro';
import UtilityStrip from '../components/UtilityStrip.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CorePillarsSection from '../components/CorePillarsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="DarkGrid Operations | Specialized Data Center Cleaning & Mission-Critical Facility Services"
  description="Specialized cleaning services for data centers and mission-critical facilities. Supporting construction, commissioning, project turnover, and ongoing operations with precision, safety, and reliability."
>
  <!-- Top Utility Strip -->
  <UtilityStrip />

  <!-- Main Navigation Header with Enlarged Logo -->
  <Navbar />

  <!-- Main Content Flow: Streamlined, Clean and Fast to Navigate -->
  <main>
    <!-- 1. Hero Section with Large Brand Lockup & Value Pillars -->
    <Hero />

    <!-- 2. The 3 Big, Bold Interactive Pillars: Services, Approach, Sectors -->
    <CorePillarsSection />

    <!-- 3. About Us: Who We Are, Our Mission & Vision -->
    <AboutSection />

    <!-- 4. Why DarkGrid? Core Operational Values -->
    <WhyChooseUs />

    <!-- 5. Contact Us & Request a Quote Form -->
    <ContactSection />
  </main>

  <!-- Dark Footer -->
  <Footer />
</Layout>
