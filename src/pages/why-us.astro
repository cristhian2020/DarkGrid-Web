---
import Layout from '../layouts/Layout.astro';
import UtilityStrip from '../components/UtilityStrip.astro';
import Navbar from '../components/Navbar.astro';
import PageHeader from '../components/PageHeader.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import SafetyCommitment from '../components/SafetyCommitment.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Why Choose Us | DarkGrid Operations — Specialized Data Center Cleaning"
  description="Discover why leading data centers trust DarkGrid Operations: specialized focus, safety-driven approach, attention to detail, and professional coordination."
>
  <UtilityStrip />
  <Navbar />
  
  <main>
    <PageHeader
      eyebrow="Trust & Accountability"
      title="Why Choose DarkGrid?"
      badge="Mission-Critical Reliability"
      description="Data centers require precision, disciplined coordination, and technicians who respect live infrastructure. Here is how DarkGrid delivers value across every project phase."
    />

    <!-- The complete Why Choose Us Section without redundant sub-header -->
    <WhyChooseUs showHeader={false} />

    <!-- Our Commitment to Safety & Quality -->
    <SafetyCommitment />

    <!-- Direct Quote Form -->
    <ContactSection />
  </main>

  <Footer />
</Layout>

