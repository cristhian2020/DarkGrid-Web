---
import {
  Crosshair,
  ShieldCheck,
  Eye,
  CalendarCheck2,
  Handshake,
  CheckCircle2,
  Award
} from 'lucide-astro';

interface Props {
  showHeader?: boolean;
}

const { showHeader = true } = Astro.props;

const reasons = [
  {
    title: 'Specialized Focus',
    description: 'Services tailored to the unique conditions of data centers and mission-critical facilities. We do not do residential or generic janitorial work — our focus is purely mission-critical.',
    icon: Crosshair,
  },
  {
    title: 'Safety-Driven Approach',
    description: 'Careful planning and hazard awareness integrated into daily operations. We protect human life, electrical continuity, and expensive hardware with pre-task analysis.',
    icon: ShieldCheck,
  },
  {
    title: 'Attention to Detail',
    description: 'A controlled cleaning approach that prioritizes sensitive equipment and surrounding infrastructure. Clean-room grade tools, anti-static measures, and HEPA particulate capture.',
    icon: Eye,
  },
  {
    title: 'Flexible Project Support',
    description: 'Services adapted to construction schedules, commissioning milestones, and operational needs. Able to deploy in off-hours, maintenance windows, or weekend sprints.',
    icon: CalendarCheck2,
  },
  {
    title: 'Professional Coordination',
    description: 'Clear communication and active collaboration with project and facility management teams. Daily sign-offs, photo logs, and formal shift debriefs.',
    icon: Handshake,
  },
];
---

<section id="why-us" class="bg-cloud py-16 md:py-24 border-b border-hairline scroll-mt-20">
  <div class="max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    {showHeader && (
      <div class="max-w-4xl mb-12 md:mb-16">
        <div class="inline-flex items-center px-4 py-1.5 rounded-[6px] bg-canvas border border-fog text-sm font-bold uppercase tracking-wider text-corporate mb-4 shadow-2xs">
          <span>Why Choose Us</span>
        </div>
        <h2 class="text-4xl sm:text-5xl lg:text-[54px] font-medium tracking-tight text-ink leading-[1.08]">
          Why DarkGrid Operations?
        </h2>
        <p class="mt-4 text-lg sm:text-xl lg:text-[22px] text-charcoal font-normal leading-relaxed">
          Data centers require precision, disciplined coordination, and technicians who respect live infrastructure. Here is how DarkGrid delivers value.
        </p>
      </div>
    )}

    <!-- 5 Value Proposition Grid (3 top, 2 bottom centered or full-width spread) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reasons.slice(0, 3).map((r, i) => {
        const Icon = r.icon;
        return (
          <div class="bg-canvas p-7 sm:p-9 rounded-[16px] border border-hairline shadow-soft-lift flex flex-col justify-between group hover:border-corporate transition-colors">
            <div>
              <div class="w-14 h-14 rounded-[10px] bg-primary-soft text-corporate flex items-center justify-center mb-6">
                <Icon class="w-7 h-7" />
              </div>
              <h3 class="text-2xl font-medium text-ink mb-3.5 leading-snug">{r.title}</h3>
              <p class="text-base text-charcoal leading-relaxed">{r.description}</p>
            </div>
            <div class="mt-7 pt-4 border-t border-fog flex items-center gap-2 text-xs sm:text-sm font-bold text-corporate uppercase tracking-wider">
              <CheckCircle2 class="w-4 h-4 text-electric" />
              <span>Core Operational Value</span>
            </div>
          </div>
        );
      })}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
      {reasons.slice(3).map((r) => {
        const Icon = r.icon;
        return (
          <div class="bg-canvas p-7 sm:p-9 rounded-[16px] border border-hairline shadow-soft-lift flex flex-col justify-between group hover:border-corporate transition-colors">
            <div>
              <div class="w-14 h-14 rounded-[10px] bg-cloud text-navy flex items-center justify-center mb-6 border border-fog group-hover:bg-primary-soft group-hover:text-corporate transition-colors">
                <Icon class="w-7 h-7" />
              </div>
              <h3 class="text-2xl font-medium text-ink mb-3.5 leading-snug">{r.title}</h3>
              <p class="text-base text-charcoal leading-relaxed">{r.description}</p>
            </div>
            <div class="mt-7 pt-4 border-t border-fog flex items-center gap-2 text-xs sm:text-sm font-bold text-corporate uppercase tracking-wider">
              <CheckCircle2 class="w-4 h-4 text-electric" />
              <span>Operational Advantage</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Assurance Banner -->
    <div class="mt-12 bg-canvas rounded-[16px] p-7 sm:p-9 border border-fog shadow-soft-lift flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-5">
        <div class="w-14 h-14 rounded-[10px] bg-corporate text-white flex items-center justify-center shrink-0 shadow-sm">
          <Award class="w-7 h-7" />
        </div>
        <div>
          <h4 class="text-lg sm:text-xl font-bold text-ink">Built on Strict Accountability</h4>
          <p class="text-sm sm:text-base text-graphite mt-1 leading-relaxed">
            Every shift includes a dedicated site lead, documented risk assessment, and transparent communication.
          </p>
        </div>
      </div>
      <a
        href="/#contact"
        class="inline-flex items-center justify-center px-7 py-3 h-12 bg-corporate hover:bg-navy text-white text-xs sm:text-sm font-semibold tracking-[0.7px] uppercase rounded-[4px] shrink-0 transition-colors shadow-sm"
      >
        <span>Partner With Us</span>
      </a>
    </div>
  </div>
</section>

