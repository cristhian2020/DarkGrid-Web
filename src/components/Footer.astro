---
import { ShieldCheck, Mail, Phone, ArrowUp, Sparkles } from 'lucide-astro';

const servicesLinks = [
  { href: '/services', label: 'Specialized Equipment Cleaning' },
  { href: '/services', label: 'Construction & Post-Construction' },
  { href: '/services', label: 'Pre-Commissioning & Turnover' },
  { href: '/services', label: 'Raised Floor & Subfloor Cleaning' },
  { href: '/services', label: 'Overhead & High-Level Cleaning' },
  { href: '/services', label: 'Preventive & Routine Cleaning' },
  { href: '/services', label: 'Customized Project Support' },
];

const companyLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Our Services' },
  { href: '/approach', label: 'Our Approach' },
  { href: '/sectors', label: 'Sectors & Applications' },
  { href: '/why-us', label: 'Why Choose Us' },
  { href: '/careers', label: 'Careers & Opportunities' },
  { href: '/#contact', label: 'Request a Quote' },
];

const environmentLinks = [
  { href: '/sectors', label: 'Hyperscale & Enterprise' },
  { href: '/sectors', label: 'Mission-Critical Facilities' },
  { href: '/sectors', label: 'Construction Sites' },
  { href: '/sectors', label: 'Commissioning & Handover' },
  { href: '/sectors', label: 'Live Data Centers' },
];
---

<footer class="bg-navy text-white/90 pt-16 pb-12 border-t border-white/10">
  <div class="max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Footer Grid (5 Columns on Desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-white/10">
      
      <!-- Column 1: Brand Info & Identity (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center gap-3.5 group">
          <img src="/assets/Emblema.png" alt="DarkGrid Operations Logo" class="h-14 w-14 sm:h-16 sm:w-16 object-contain group-hover:scale-105 transition-transform" />
          <div class="flex flex-col">
            <span class="text-white font-bold tracking-wider text-xl sm:text-2xl leading-none">
              DARKGRID
            </span>
            <span class="text-[11px] sm:text-xs font-semibold tracking-[0.28em] text-cyan uppercase mt-1 leading-none">
              OPERATIONS
            </span>
          </div>
        </a>

        <p class="text-xs sm:text-sm text-white/70 leading-relaxed max-w-sm">
          Specialized Data Center Cleaning & Mission-Critical Facility Services. Delivering safe work practices, equipment protection, and operational excellence.
        </p>

        <div class="pt-2 text-xs text-cyan font-semibold tracking-wider uppercase flex items-center gap-2">
          <Sparkles class="w-3.5 h-3.5 text-cyan" />
          <span>Solutions for a Stronger Tomorrow</span>
        </div>

        <div class="pt-3 space-y-2 text-xs text-white/80">
          <div class="flex items-center gap-2">
            <Phone class="w-3.5 h-3.5 text-cyan" />
            <a href="tel:+17039390923" class="hover:text-white transition-colors">+1 (703) 939-0923</a>
          </div>
          <div class="flex items-center gap-2">
            <Mail class="w-3.5 h-3.5 text-cyan" />
            <a href="mailto:info@darkgridoperations.com" class="hover:text-white transition-colors break-all">info@darkgridoperations.com</a>
          </div>
        </div>
      </div>

      <!-- Column 2: Services (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">
          Our Services
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-white/70">
          {servicesLinks.map((s) => (
            <li>
              <a href={s.href} class="hover:text-white transition-colors inline-block py-0.5">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Environments (3 cols) -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">
          Environments We Support
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-white/70">
          {environmentLinks.map((e) => (
            <li>
              <a href={e.href} class="hover:text-white transition-colors inline-block py-0.5">
                {e.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="pt-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-2">
            Pillars of Execution
          </h4>
          <p class="text-xs text-white/60">
            Precision • Safety • Reliability
          </p>
        </div>
      </div>

      <!-- Column 4: Quick Navigation & Action (2 cols) -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">
          Company
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm text-white/70">
          {companyLinks.map((c) => (
            <li>
              <a href={c.href} class="hover:text-white transition-colors inline-block py-0.5">
                {c.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="pt-4">
          <a
            href="#contact"
            class="inline-flex items-center justify-center w-full px-4 py-2 bg-primary-bright hover:bg-primary text-white text-xs font-semibold tracking-[0.7px] uppercase rounded-[4px] transition-colors"
          >
            <span>Get a Quote</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Strip: Copyright & Disclaimers -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-steel">
      <div>
        © {new Date().getFullYear()} DarkGrid Operations. All rights reserved.
      </div>

      <div class="flex items-center gap-6">
        <span>Confidential & Proprietary Protocols</span>
        <span>•</span>
        <span>Mission-Critical Standards</span>
        <span>•</span>
        <a href="#home" class="hover:text-white transition-colors inline-flex items-center gap-1">
          <span>Back to Top</span>
          <ArrowUp class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

  </div>
</footer>

