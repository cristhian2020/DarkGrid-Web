---
import {
  Briefcase,
  HardHat,
  UserCheck,
  Wrench,
  FileCheck,
  Mail,
  ArrowRight,
  ShieldCheck,
  CheckCircle2
} from 'lucide-astro';

const roles = [
  {
    title: 'Data Center Cleaning Technicians',
    type: 'Full-time / Project-based',
    desc: 'Hands-on execution of precision cleaning in white space, subfloors, and mechanical rooms according to strict SOPs.',
    icon: HardHat,
    requirements: ['Attention to detail', 'Adherence to safety protocols', 'Cleanroom awareness'],
  },
  {
    title: 'Cleaning Supervisors',
    type: 'Full-time',
    desc: 'Supervising on-site technician teams, quality control inspections, chemical usage controls, and schedule adherence.',
    icon: UserCheck,
    requirements: ['Prior supervisory experience', 'Quality inspection rigor', 'Team leadership'],
  },
  {
    title: 'Site Leads',
    type: 'Full-time',
    desc: 'Acting as primary liaison between DarkGrid and general contractors or facility management; managing daily toolbox talks.',
    icon: ShieldCheck,
    requirements: ['Client-facing coordination', 'OSHA safety training', 'Documentation discipline'],
  },
  {
    title: 'Field Operations Personnel',
    type: 'Full-time / Flexible',
    desc: 'Mobilization, logistics support, specialized equipment maintenance (HEPA vacuums, scrubbers), and consumables tracking.',
    icon: Wrench,
    requirements: ['Equipment maintenance knowledge', 'Logistics coordination', 'Reliability'],
  },
  {
    title: 'Project Coordination & Administrative Support',
    type: 'Full-time / Remote-hybrid',
    desc: 'Supporting scheduling, client reporting, badging clearance coordination, and daily work documentation archives.',
    icon: FileCheck,
    requirements: ['Organizational skills', 'Clear communication', 'Data center badging familiarity'],
  },
];
---

<section id="careers" class="bg-canvas py-16 md:py-24 border-b border-hairline scroll-mt-20">
  <div class="max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Header -->
    <div class="max-w-3xl mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-cloud border border-fog text-xs font-semibold uppercase tracking-wider text-primary mb-3">
        <span>Careers & Opportunities</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-medium tracking-tight text-ink leading-tight">
        Build Your Career with DarkGrid
      </h2>
      <p class="mt-4 text-base sm:text-lg text-charcoal">
        At DarkGrid Operations, we value safety, professionalism, teamwork, and attention to detail. We welcome motivated individuals interested in supporting mission-critical data center projects.
      </p>
    </div>

    <!-- 2 Column Layout: Open Roles (7 cols) + Resume CTA Box (5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Open Roles Grid (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-graphite mb-2">
          Career Opportunities May Include:
        </h3>

        {roles.map((r) => {
          const Icon = r.icon;
          return (
            <div class="bg-canvas p-5 sm:p-6 rounded-[16px] border border-hairline shadow-soft-lift hover:border-primary/40 transition-colors">
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-[8px] bg-primary-soft text-primary flex items-center justify-center shrink-0 mt-0.5">
                    <Icon class="w-5 h-5" />
                  </div>
                  <div>
                    <h4 class="text-base sm:text-lg font-medium text-ink leading-snug">
                      {r.title}
                    </h4>
                   
                    <p class="text-xs sm:text-sm text-charcoal mt-2 leading-relaxed">
                      {r.desc}
                    </p>
                  </div>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-fog flex flex-wrap items-center gap-2">
                <span class="text-[11px] font-semibold text-graphite uppercase mr-1">Skills:</span>
                {r.requirements.map((req) => (
                  <span class="text-[11px] bg-cloud text-ink font-medium px-2.5 py-0.5 rounded border border-fog">
                    {req}
                  </span>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <!-- Resume Submission Box (5 cols) -->
      <div class="lg:col-span-5 sticky top-28">
        <div class="bg-cloud p-6 sm:p-8 rounded-[16px] border border-fog shadow-soft-lift flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-[8px] bg-primary text-white flex items-center justify-center mb-5">
              <Mail class="w-6 h-6" />
            </div>

            <span class="text-xs font-bold uppercase tracking-wider text-primary">
              Join Our Growing Team
            </span>

            <h3 class="text-2xl font-medium text-ink mt-1 mb-3">
              Interested in joining DarkGrid Operations?
            </h3>

            <p class="text-sm text-charcoal leading-relaxed mb-6">
              We are constantly seeking dedicated professionals who take pride in precision and safety. Whether you have years of cleanroom experience or are eager to train into data center operations, we want to hear from you.
            </p>

            <div class="bg-canvas p-4 rounded-[8px] border border-fog space-y-3 mb-6">
              <div class="flex flex-col">
                <span class="text-xs text-graphite uppercase font-medium">Send Resume To:</span>
                <a
                  href="mailto:info@darkgridoperations.com?subject=Career%20Opportunity%20%E2%80%93%20DarkGrid%20Operations"
                  class="text-sm font-semibold text-primary hover:underline break-all"
                >
                  info@darkgridoperations.com
                </a>
              </div>
              <div class="flex flex-col pt-2 border-t border-fog">
                <span class="text-xs text-graphite uppercase font-medium">Required Subject Line:</span>
                <code class="text-xs bg-cloud px-2 py-1 rounded text-ink font-mono mt-1 font-semibold border border-fog">
                  Career Opportunity – DarkGrid Operations
                </code>
              </div>
            </div>

            <div class="space-y-2 mb-6 text-xs text-graphite">
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>Competitive compensation & safety gear provided</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>Comprehensive mission-critical training programs</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
                <span>Clear path to supervisory and site lead roles</span>
              </div>
            </div>
          </div>

          <a
            href="mailto:info@darkgridoperations.com?subject=Career%20Opportunity%20%E2%80%93%20DarkGrid%20Operations"
            class="inline-flex items-center justify-center w-full px-6 py-3.5 bg-primary hover:bg-primary-deep text-white font-semibold text-xs tracking-[0.7px] uppercase rounded-[4px] shadow-sm transition-all"
          >
            <span>Submit Your Resume</span>
            <ArrowRight class="w-4 h-4 ml-2" />
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

